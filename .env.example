# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# BTL HỆ PHÂN TÁN - TOPIC DS03: RIDE-HAILING MICROSERVICES (FINAL MVP 7.1-7.4)
# ==============================================================================

# GLOBAL SYSTEM CONFIG
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=super-secret-jwt-key-distributed-systems-2026
# JWT_ISSUER / JWT_AUDIENCE để trống mặc định ở bản Final đơn giản (ADR-007)

# INTERNAL SERVICE AUTH KEYS (chỉ dùng cho môi trường dev/demo cục bộ)
INTERNAL_KEY=ds03-internal-secret-dev
DRIVER_INTERNAL_KEY=ds03-driver-internal-secret-dev
DRIVER_TRIP_KEY=ds03-driver-trip-secret-dev
MATCHING_INTERNAL_KEY=ds03-matching-internal-secret-dev

# EVENT TRANSPORT & RABBITMQ CONFIGURATION
# Dùng 'rabbitmq' cho Docker Compose Full Stack; TV1 local test có thể fallback 'http' khi không có RABBITMQ_URL
EVENT_TRANSPORT=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=trip.exchange
RABBITMQ_DLX=trip.dlx
RABBITMQ_DLQ=trip.dlq

# POSTGRES 17 INFRASTRUCTURE (Mỗi service giữ database & role riêng - Database-per-Service)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_password

# MICROSERVICES PORTS & DATABASE NAMES / PASSWORDS
# 1. API Gateway
GATEWAY_PORT=8080

# 2. Identity Service (SQLite WAL cục bộ ở TV1 hoặc Postgres ở Docker nếu cần)
IDENTITY_SERVICE_PORT=8001
IDENTITY_DB_NAME=user_db
IDENTITY_DB_PASSWORD=identity_secret_password

# 3. Driver & Location Service
DRIVER_SERVICE_PORT=8002
DRIVER_DB_NAME=driver_db
DRIVER_DB_PASSWORD=driver_secret_password

# 4. Trip Booking & Saga Service (SQLite WAL bền vững)
TRIP_SERVICE_PORT=8003
TRIP_DB_NAME=trip_db
TRIP_DB_PASSWORD=trip_secret_password

# 5. Matching & Dynamic Pricing Service
MATCHING_SERVICE_PORT=8004
MATCHING_DB_NAME=match_db
MATCHING_DB_PASSWORD=matching_secret_password

# 6. Payment Service (PostgreSQL 17 + Outbox SKIP LOCKED + Lease Fencing)
PAYMENT_SERVICE_PORT=8005
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_PASSWORD=payment_secret_password

# 7. Notification Service (Consumer thông báo Passenger & Driver)
NOTIFICATION_SERVICE_PORT=8006

# 8. Web Simulation Dashboard
DASHBOARD_PORT=3000
